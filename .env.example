NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (no trailing slash) — used for sitemap, OG, password reset
NEXT_PUBLIC_SITE_URL=https://exam-bridge-one.vercel.app

# --- Payments (v31) ---
# Payment mode is chosen in Admin → Settings (Manual bank transfer vs Automated Flutterwave).
# Env vars win over the keys saved in Admin settings, so a bad DB value can't break checkout.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
